# ──────────────────────────────────────────────────────
# Chronos Ledger — Environment Configuration Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ──────────────────────────────────────────────────────

# Database
DATABASE_URL=postgresql://chronos_admin:change_me_password@chronos-db:5432/chronos_ledger

# Redis
REDIS_URL=redis://chronos-cache:6379/0

# JWT — generate with: openssl rand -hex 32
JWT_SECRET_SIGNING_KEY=replace_with_64_char_hex_secret_generated_by_openssl_rand_hex_32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480

# App
APP_ENV=production
APP_CORS_ORIGINS=http://localhost,http://localhost:3000

# Campus domain (used for cookie scope on intranet)
CAMPUS_DOMAIN_MASK=college.internal

# Web Push (VAPID keys — generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_CONTACT_EMAIL=admin@college.internal

# Database password (used by both postgres container and backend DATABASE_URL)
DB_PASSWORD=change_me_password

# Frontend (injected at build time via Next.js)
NEXT_PUBLIC_API_URL=http://localhost/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost/ws
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key_here

# Telemetry (CFlair-Counter — Life-Experimentalist/CFlair-Counter)
# Set NEXT_PUBLIC_TELEMETRY_ENABLED=false to globally disable all client pings.
# TELEMETRY_ENDPOINT is your CFlair-Counter Cloudflare Pages deployment URL.
NEXT_PUBLIC_TELEMETRY_ENABLED=true
NEXT_PUBLIC_TELEMETRY_ENDPOINT=https://counter.vkrishna04.me
TELEMETRY_ENABLED=true
TELEMETRY_ENDPOINT=https://counter.vkrishna04.me
