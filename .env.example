# ──────────────────────────────────────────────────────
# Chronos Ledger: Environment Configuration Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ──────────────────────────────────────────────────────

# Database
DATABASE_URL=postgresql://chronos_admin:change_me_password@chronos-db:5432/chronos_ledger

# Redis
REDIS_URL=redis://chronos-cache:6379/0

# JWT, generate with: openssl rand -hex 32
JWT_SECRET_SIGNING_KEY=replace_with_64_char_hex_secret_generated_by_openssl_rand_hex_32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
# A refresh token is single use: spending one returns a new pair.
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# The first password for the built-in administrator account. Nothing can
# log in as the administrator until this is set: the account is seeded with
# a hash of a random string that is thrown away, so this repository
# publishes no password for anyone to find. It is applied on boot while
# that account is still waiting for a password of its own, and does nothing
# once you have logged in and chosen one. An admin password reset puts the
# account back into that waiting state, so remove this line once you are
# in. setup.sh generates a value and prints it once.
INITIAL_ADMIN_PASSWORD=replace_with_the_first_admin_password

# App
APP_ENV=production
APP_CORS_ORIGINS=http://localhost,http://localhost:3000

# Organization domain (used for cookie scope on intranet)
ORG_DOMAIN_MASK=org.internal

# What the interface calls people and bookings: generic, campus or
# hospital. Labels only. The schema, the API and the data are identical
# whichever you pick, so this is safe to change on a running instance.
ORG_PROFILE=generic

# Where the organization is, as an IANA name. This decides what "today" means:
# which sessions the dashboard shows, which day the nightly generator lays
# down, and when 23:00 is. A container runs UTC, so leaving this unset for an
# organization that is not in UTC puts the dashboard a whole offset out.
# An offset like +05:30 is refused, because it cannot know when daylight
# saving moves. The server is refused to start on a name no zone database
# knows, rather than quietly falling back.
ORG_TIMEZONE=UTC

# Web Push (VAPID keys, generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_CONTACT_EMAIL=admin@org.internal

# Database password (used by both postgres container and backend DATABASE_URL)
DB_PASSWORD=change_me_password

# Frontend (injected at build time via Next.js)
NEXT_PUBLIC_API_URL=http://localhost/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost/ws
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key_here

# Telemetry (CFlair-Counter: Life-Experimentalist/CFlair-Counter): OPT-IN.
# Off by default: a stock install talks to nothing outside your network.
# To turn it on, set ENABLED=true *and* point ENDPOINT at a CFlair-Counter
# instance you run. Both must be set; an empty endpoint disables the pings.
NEXT_PUBLIC_TELEMETRY_ENABLED=false
NEXT_PUBLIC_TELEMETRY_ENDPOINT=
TELEMETRY_ENABLED=false
TELEMETRY_ENDPOINT=

# Deployment, read by docker-compose rather than by the app.
# EDGE_HTTP_PORT and EDGE_HTTPS_PORT are the HOST ports the edge proxy
# surfaces on; the container always listens on 80 and 443. Set them when
# another stack on the same host owns 80 and 443, so Chronos can sit behind
# an outer proxy instead of competing for the ports.
EDGE_HTTP_PORT=80
EDGE_HTTPS_PORT=443

# Which published images docker-compose.prod.yml pulls. VERSION takes a tag
# or a digest; pin a digest for a reproducible deploy. GHCR_OWNER has to be
# lowercase even when the GitHub account is not, because a registry refuses a
# repository path with a capital in it.
GHCR_OWNER=life-experimentalist
VERSION=latest
