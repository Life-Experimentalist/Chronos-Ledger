# ──────────────────────────────────────────────────────
# Chronos Ledger: Environment Configuration Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ──────────────────────────────────────────────────────

# Database
DATABASE_URL=postgresql://chronos_admin:change_me_password@chronos-db:5432/chronos_ledger

# Redis
REDIS_URL=redis://chronos-cache:6379/0

# JWT, generate with: openssl rand -hex 32
JWT_SECRET_SIGNING_KEY=replace_with_64_char_hex_secret_generated_by_openssl_rand_hex_32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
# A refresh token is single use: spending one returns a new pair.
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# The first password for the built-in administrator account. Nothing can
# log in as the administrator until this is set: the account is seeded with
# a hash of a random string that is thrown away, so this repository
# publishes no password for anyone to find. It is applied on boot while
# that account is still waiting for a password of its own, and does nothing
# once you have logged in and chosen one. An admin password reset puts the
# account back into that waiting state, so remove this line once you are
# in. setup.sh generates a value and prints it once.
INITIAL_ADMIN_PASSWORD=replace_with_the_first_admin_password

# The shortest password a person is allowed to choose: the first-login
# change, and any account an admin creates with a password they typed. The
# passwords the system generates for itself (the CSV importer, an admin
# reset) are random and not measured against this. Raise it if your policy
# says so; it refuses to go below 8.
PASSWORD_MIN_LENGTH=12

# Rate limits. Counted in Redis over a fixed window, on the three routes
# where hammering pays: sign-in, the visitor kiosk, and the calendar feed.
# Set any count to 0 to turn that one off, or RATE_LIMIT_ENABLED=false to
# turn off all three. Redis being unreachable turns them off too: it is a
# cache here and not a system of record, and an instance that cannot see it
# should keep letting people in rather than lock the organization out until
# it comes back.
RATE_LIMIT_ENABLED=true
# Failed sign-ins per 15 minutes, per calling address and per account. Both
# are counted, and a correct password costs neither.
RATE_LIMIT_LOGIN_PER_IP=10
RATE_LIMIT_LOGIN_PER_EMAIL=5
# Visitor check-ins per kiosk account per hour. Loose on purpose: a busy
# front desk is genuinely fast, and a limit that interrupts real work gets
# switched off, which is worse than a loose one.
RATE_LIMIT_GUEST_CHECKIN=300
# Calendar feed fetches per feed token per hour. Apple Calendar's fastest
# refresh is twelve an hour by itself, and somebody with a phone and a
# laptop is two of those.
RATE_LIMIT_CALENDAR_FEED=60

# App
APP_ENV=production
APP_CORS_ORIGINS=http://localhost,http://localhost:3000

# Whether this instance serves its own API documentation at /docs, /redoc
# and /openapi.json. Left blank it follows APP_ENV: off in production, on
# everywhere else. The interactive docs are how somebody learns this API,
# and publishing the whole surface of a live instance is how somebody finds
# the parts of it they were not meant to reach. Set true to publish them
# anyway (an internal-only instance, say), or false to keep them off in
# development too.
DOCS_ENABLED=

# Which upstream addresses uvicorn will believe X-Forwarded-For from. The
# app container publishes no ports of its own, so nginx inside the compose
# network is the only way in and * costs nothing here. It matters because
# without it every request arrives from the proxy: the sign-in rate limit
# would count the whole organization as one caller, and ten failed attempts
# by one person would lock out everybody. Trusting the header is safe here
# because nginx overwrites it rather than appending to it, so a caller
# cannot name its own address. If you put another proxy in front of this
# stack, do not widen this: turn on nginx's realip module in
# nginx/chronos-common.conf so the address nginx sees is the real client.
FORWARDED_ALLOW_IPS=*

# Organization domain (used for cookie scope on intranet)
ORG_DOMAIN_MASK=org.internal

# What the interface calls the engine's six nouns, one variable each. Blank
# means the engine's own neutral word (Staff, Member, Activity, Unit, Lead,
# Cycle), so set as few or as many as your words need. Labels only: the
# schema, the API and the data are identical whatever you put here, so these
# are safe to change on a running instance.
#
# There are no presets. A domain does not agree with itself: two universities
# in one city will disagree on Course against Module, and "Faculty" is the
# unit at some institutions and the person at others. Expect to set all six.
# docs/vocabulary.md has the whole subject, including what labels never
# change: the API fields, the columns and the CSV headers stay as they are
# whatever the screen says.
LABEL_STAFF=
LABEL_MEMBER=
LABEL_ACTIVITY=
LABEL_UNIT=
LABEL_LEAD=
LABEL_CYCLE=

# Where the organization is, as an IANA name. This decides what "today" means:
# which sessions the dashboard shows, which day the nightly generator lays
# down, and when 23:00 is. A container runs UTC, so leaving this unset for an
# organization that is not in UTC puts the dashboard a whole offset out.
# An offset like +05:30 is refused, because it cannot know when daylight
# saving moves. The server is refused to start on a name no zone database
# knows, rather than quietly falling back.
ORG_TIMEZONE=UTC

# Web Push (VAPID keys, generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_CONTACT_EMAIL=admin@org.internal

# Database password (used by both postgres container and backend DATABASE_URL)
DB_PASSWORD=change_me_password

# Frontend (injected at build time via Next.js)
NEXT_PUBLIC_API_URL=http://localhost/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost/ws
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key_here

# Telemetry (CFlair-Counter: Life-Experimentalist/CFlair-Counter): OPT-IN.
# Off by default: a stock install talks to nothing outside your network.
# To turn it on, set ENABLED=true *and* point ENDPOINT at a CFlair-Counter
# instance you run. Both must be set; an empty endpoint disables the pings.
NEXT_PUBLIC_TELEMETRY_ENABLED=false
NEXT_PUBLIC_TELEMETRY_ENDPOINT=
TELEMETRY_ENABLED=false
TELEMETRY_ENDPOINT=

# Deployment, read by docker-compose rather than by the app.
# EDGE_HTTP_PORT and EDGE_HTTPS_PORT are the HOST ports the edge proxy
# surfaces on; the container always listens on 80 and 443. Set them when
# another stack on the same host owns 80 and 443, so Chronos can sit behind
# an outer proxy instead of competing for the ports.
EDGE_HTTP_PORT=80
EDGE_HTTPS_PORT=443

# Which published images docker-compose.prod.yml pulls. VERSION takes a tag
# or a digest; pin a digest for a reproducible deploy. GHCR_OWNER has to be
# lowercase even when the GitHub account is not, because a registry refuses a
# repository path with a capital in it.
GHCR_OWNER=life-experimentalist
VERSION=latest
