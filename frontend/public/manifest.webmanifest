  "shortcuts": [
    {
      "name": "My Schedule",
      "short_name": "Schedule",
      "description": "View today's class schedule",
      "url": "/student/dashboard/",
      "icons": [{ "src": "/icons/icon-96x96.png", "sizes": "96x96" }]
    },
    {
      "name": "Mark Attendance",
      "short_name": "Attendance",
      "description": "Mark class attendance",
      "url": "/student/dashboard/?action=mark",
      "icons": [{ "src": "/icons/icon-96x96.png", "sizes": "96x96" }]
    },
    {
      "name": "Guest Check-In",
      "short_name": "Check-In",
