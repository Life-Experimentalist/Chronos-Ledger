{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "bootstrap-sha": "6c85fc840b0b6314c424acf7182982e433bf31d9",
  "packages": {
    ".": {
      "release-type": "simple",
      "changelog-path": "CHANGELOG.md",
      "bump-minor-pre-major": true,
      "bump-patch-for-minor-pre-major": true,
      "extra-files": [
        { "type": "json", "path": "frontend/package.json",  "jsonpath": "$.version" },
        { "type": "toml", "path": "backend/pyproject.toml", "jsonpath": "$.project.version" },
        { "type": "toml", "path": "cli/Cargo.toml",         "jsonpath": "$.package.version" },
        { "type": "toml", "path": "cli/Cargo.lock",         "jsonpath": "$.package[?(@.name.value=='chronos-ledger-cli')].version" },
        { "type": "toml", "path": "backend/uv.lock",        "jsonpath": "$.package[?(@.name.value=='chronos-ledger-backend')].version" },
        { "type": "toml", "path": "sdks/python/uv.lock",    "jsonpath": "$.package[?(@.name.value=='chronos-ledger-client')].version" },
        { "type": "json", "path": "frontend/package-lock.json",        "jsonpath": "$.version" },
        { "type": "json", "path": "frontend/package-lock.json",        "jsonpath": "$.packages[''].version" },
        { "type": "json", "path": "sdks/typescript/package-lock.json", "jsonpath": "$.version" },
        { "type": "json", "path": "sdks/typescript/package-lock.json", "jsonpath": "$.packages[''].version" },
        { "type": "json", "path": "sdks/typescript/package.json", "jsonpath": "$.version" },
        { "type": "toml", "path": "sdks/python/pyproject.toml",   "jsonpath": "$.project.version" },
        { "type": "toml", "path": "sdks/rust/Cargo.toml",         "jsonpath": "$.package.version" },
        { "type": "toml", "path": "sdks/rust/Cargo.lock",         "jsonpath": "$.package[?(@.name.value=='chronos-ledger-client')].version" },
        "sdks/typescript/src/version.ts",
        "sdks/python/src/chronos_ledger_client/__init__.py",
        "sdks/go/version.go",
        "docs/openapi.yaml",
        "sdks/rust/openapi.yaml",
        "backend/app/main.py",
        "charts/chronos-ledger/Chart.yaml"
      ],
      "changelog-sections": [
        { "type": "feat",     "section": "Features" },
        { "type": "fix",      "section": "Bug Fixes" },
        { "type": "perf",     "section": "Performance" },
        { "type": "security", "section": "Security" },
        { "type": "deps",     "section": "Dependencies", "hidden": false },
        { "type": "refactor", "section": "Code Refactoring", "hidden": true },
        { "type": "chore",    "section": "Miscellaneous", "hidden": true }
      ]
    }
  }
}
